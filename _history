game.splash(\"¡Bienvenido al Quiz!\", \"Responde las siguientes preguntas\");\n\n// Generar mínimo 4 preguntas\naskMathQuestion(\"¿Cuanto es 2 + 2?\", 4);\naskMathQuestion(\"¿Cuanto es 5 + 3?\", 8);\naskMathQuestion(\"¿Cuanto es 10 - 4?\", 6);\naskMathQuestion(\"¿Cuanto es 3 x 3?\", 9);\n\n// Determinar el nombre del color resultante para mostrarlo en pantalla\nlet colorName = \"Blanco\";\nif (correctAnswers === 1) colorName = \"Naranja\";\nelse if (correctAnswers === 2) colorName = \"Amarillo\";\nelse if (correctAnswers === 3) colorName = \"Verde claro\";\nelse if (correctAnswers >= 4) colorName = \"Verde oscuro\";\n\n// Cuando terminen las preguntas muestre la información de puntos y el color resultante.\ngame.splash(\"Resultados del Quiz:\");\ngame.splash(\"Puntos totales: \" + info.score());\ngame.splash(\"Color resultante: \" + colorName);\n\n// Finalizar el juego\ngame.over(true);","README.md":" ","assets.json":"","main.py":"\n","tilemap.g.jres":"{\n    \"transparency16\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true\n    },\n    \"tile1\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\",\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"tilemapTile\": true,\n        \"displayName\": \"miMosaico\"\n    },\n    \"*\": {\n        \"mimeType\": \"image/x-mkcd-f4\",\n        \"dataEncoding\": \"base64\",\n        \"namespace\": \"myTiles\"\n    }\n}","tilemap.g.ts":"","images.g.jres":"{\n    \"image1\": {\n        \"data\": \"hwQQABAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA